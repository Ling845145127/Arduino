const int buttonPin = 7;
const int r = 9;
const int g = 10;
const int b = 11;

int buttonState = 0;
int color = 0;

bool buttonPressed = false;

void setup() {
  Serial.begin(9600);

  pinMode(r, OUTPUT);
  pinMode(g, OUTPUT);
  pinMode(b, OUTPUT);

  pinMode(buttonPin, INPUT);
}

void loop() {
  buttonState = digitalRead(button);

  if (buttonState == 1 && !buttonPressed){
    color += 1;
    buttonPressed = true;
  }
  else if (buttonState == 0 && buttonPressed) {
    buttonPressed = false;
  }
  
  if (color == 0){
    digitalWrite(r, 0);
    digitalWrite(g, 1); 
    digitalWrite(b, 1);
  }
  else if (color == 1){
    digitalWrite(r, 0);
    digitalWrite(g, 0); 
    digitalWrite(b, 1);
  }
  else if (color == 2){
    digitalWrite(r, 1);
    digitalWrite(g, 0); 
    digitalWrite(b, 1);
  }
  else if (color == 3){
    digitalWrite(r, 1);
    digitalWrite(g, 1); 
    digitalWrite(b, 0);
  }
  else if (color == 4){
    digitalWrite(r, 0);
    digitalWrite(g, 1); 
    digitalWrite(b, 0);
  }
  else if (color == 5){
    color = 0;
  }
}
